# Read this file as documentation. The app reads the process environment;
# it does not automatically load this file. Never commit real tokens.
BOUNTYOS_PORT=8787
BOUNTYOS_DATA_DIR=./data
BOUNTYOS_OLLAMA_URL=http://127.0.0.1:11434
BOUNTYOS_MODEL=qwen2.5-coder:7b
# start-windows.cmd defaults to qwen2.5-coder:3b and a longer CPU timeout.
# BOUNTYOS_MODEL_TIMEOUT=1800
# Optional for automatic GitHub pull requests. Reuse an existing GH_TOKEN.
# GH_TOKEN=

